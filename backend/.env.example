NODE_ENV=development
PORT=3000
API_VERSION=v1

# Neon — required (sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

REDIS_URL=redis://localhost:6379

# Clerk — required for auth
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Comma-separated origins allowed in token (Flutter web / API)
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:5173
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# Backblaze B2 — optional in dev (signed URLs null until set)
B2_KEY_ID=xxx
B2_APPLICATION_KEY=xxx
B2_BUCKET=lossdefender-v1-media
B2_ENDPOINT=https://s3.us-west-002.backblazeb2.com
B2_SIGNED_URL_TTL=900

# Razorpay — optional until billing live
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Seed helpers (optional)
SEED_ADMIN_EMAIL=admin@demo.lossdefender.in
SEED_OPERATOR_EMAIL=operator@demo.lossdefender.in
# After you sign up in Clerk dashboard/app, paste user id here and re-run seed:
# SEED_ADMIN_CLERK_ID=user_xxxxxxxx

# Feature flags (default off until live)
FEATURE_BILLING=false
FEATURE_MARKETPLACE_SYNC=false
FEATURE_FFMPEG=false
CLERK_WEBHOOK_SIGNING_SECRET=
CORS_ORIGINS=http://localhost:*,https://app.lossdefender.in
